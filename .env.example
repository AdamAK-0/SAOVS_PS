# Copy this file to .env on each server and fill in real secrets.
# .env is intentionally gitignored.

SAOVS_SMTP_HOST=smtp-relay.brevo.com
SAOVS_SMTP_PORT=587
SAOVS_SMTP_USERNAME=your-brevo-smtp-login
SAOVS_SMTP_PASSWORD=your-brevo-smtp-password
SAOVS_SMTP_USE_TLS=1
SAOVS_SMTP_FROM=noreply@saovs.com

# Optional content location. If omitted, scripts/run_private_server.ps1 will
# auto-detect content/files, content/SAOVS, or Adam's local SAOVS_Project path.
# SAOVS_CONTENT_ROOT=C:\path\to\SAOVS\data1\com.bandainamcoent.saovsww\files

# Optional account-flow settings.
SAOVS_EMAIL_CODE_TTL_SECONDS=300
SAOVS_EMAIL_CODE_RESEND_SECONDS=60
SAOVS_EMAIL_CODE_ATTEMPT_LIMIT=10
