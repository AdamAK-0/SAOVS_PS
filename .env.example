# Copy this file to .env on each server and fill in real secrets.
# .env is intentionally gitignored.

SAOVS_SMTP_HOST=smtp-relay.brevo.com
SAOVS_SMTP_PORT=587
SAOVS_SMTP_USERNAME=your-brevo-smtp-login
SAOVS_SMTP_PASSWORD=your-brevo-smtp-password
SAOVS_SMTP_USE_TLS=1
SAOVS_SMTP_FROM=noreply@saovs.com

# Admin dashboard protection. Change these immediately on shared/VPS hosts.
SAOVS_ADMIN_USERNAME=admin
SAOVS_ADMIN_PASSWORD=admin

# Optional bootstrap/default account mapping. Use an email here so reset
# password works for the first account too.
SAOVS_DEFAULT_LOGIN_USERNAME=admin@example.com

# Optional content location. If omitted, scripts/run_private_server.ps1 will
# auto-detect content/files, content/SAOVS, or Adam's local SAOVS_Project path.
# SAOVS_CONTENT_ROOT=C:\path\to\SAOVS\data1\com.bandainamcoent.saovsww\files

# Optional account-flow settings.
SAOVS_EMAIL_CODE_TTL_SECONDS=300
SAOVS_EMAIL_CODE_RESEND_SECONDS=60
SAOVS_EMAIL_CODE_ATTEMPT_LIMIT=10
SAOVS_PASSWORD_RESET_LIMIT_SECONDS=86400

# Browser equipment customizer.
SAOVS_CUSTOMIZER_HOSTS=customizeequipement.saovs.com,customizeequipment.saovs.com
SAOVS_CUSTOMIZER_PUBLIC_URL=https://customizeequipment.saovs.com/
SAOVS_CUSTOMIZER_SESSION_TTL_SECONDS=2592000
SAOVS_ABILITY_COPY_LIMIT=99
SAOVS_GAME_DEFAULT_ABILITY_COPIES=3
# SAOVS_CUSTOMIZER_CONTENT_DIR=C:\path\to\SAOVS_PS\content\customizer

# Keep this enabled. The game uses user_list.db to supply its fixed default
# ability cards; the server excludes those defaults from generated payloads.
SAOVS_SERVE_STATIC_USER_LIST_DB=1

# Stability diagnostics and full-health checks.
SAOVS_ROUTE_SLOW_SECONDS=10
SAOVS_RECENT_ERROR_LIMIT=50
SAOVS_SQLITE_TIMEOUT_SECONDS=10
SAOVS_ASSET_INDEX_TTL_SECONDS=3600
SAOVS_ASSET_MISS_REFRESH_COOLDOWN_SECONDS=30
# SAOVS_TEMPLATE_SAVE_DIR=C:\path\to\SAOVS_PS\template_save
# SAOVS_SAVES_DIR=C:\path\to\SAOVS_PS\saves
